# 1. SUPABASE (Obtén estos valores en Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="tu-anon-key-publica-de-supabase"

# 2. GOOGLE GEMINI AI (Obtén tu API Key gratis en https://aistudio.google.com/apikey)
GEMINI_API_KEY="AIzaSyTuClaveDeGeminiAqui"
